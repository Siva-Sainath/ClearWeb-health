# Backend API URL (Render Web Service)
NEXT_PUBLIC_BACKEND_URL=https://clearweb-health-api.onrender.com

# WebCmd Bridge Secret (Must match backend WEBCMD_BRIDGE_SECRET)
WEBCMD_BRIDGE_SECRET=your_shared_webcmd_bridge_secret

# Frontend Feature Flags & Agent Settings (hackathon / judge demo)
NEXT_PUBLIC_AGENTIC_RESULTS=true
NEXT_PUBLIC_USE_LLM_EXPLANATION=true
NEXT_PUBLIC_SKIP_ONBOARDING=false
NEXT_PUBLIC_DEMO_INSTANT_RESULTS=false
NEXT_PUBLIC_HACKATHON_DEMO_MODE=false
NEXT_PUBLIC_PREFER_LOCAL_STT=false

# Optional TTS Voice Customization
NEXT_PUBLIC_TTS_VOICE=en-US-AriaNeural
NEXT_PUBLIC_TTS_RATE=+4%
NEXT_PUBLIC_TTS_PITCH=+0Hz
