# Clearweb Health Backend Environment
PORT=3001
OLLAMA_BASE=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
WHISPER_MODEL=local-xenova-whisper-tiny.en

# Bright Data Scraper Studio API key (same value as scraper/.env BRIGHTDATA_API_KEY)
# Get from: https://brightdata.com/cp/setting/users → API Key
# When unset, scrape service fails. Real pipeline uses Bright Data products only.
BRIGHT_DATA_API_TOKEN=

# Web Unlocker zone for all MRF file downloads + portal fallback fetches
# Create at: https://brightdata.com/cp/zones → Add → Web Unlocker
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
SCRAPER_PYTHON=../scraper/.venv/bin/python

# webcmd bridge (must match frontend WEBCMD_BRIDGE_SECRET)
WEBCMD_BRIDGE_SECRET=clearweb-dev-bridge
WEBCMD_ENABLED=true
FRONTEND_URL=http://localhost:3000

# Edge TTS — Aria voice (warm, clear clinical tone)
TTS_VOICE=en-US-AvaMultilingualNeural
TTS_RATE=-2%
TTS_PITCH=-1Hz
