# Clearweb Health Backend Environment
PORT=3001

# ─── LLM (pick one provider) ───────────────────────────────────────────────
# Local dev:
LLM_PROVIDER=ollama
OLLAMA_BASE=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# LLM via OpenRouter (free stealth/ox-alpha for dev + subagent tasks)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=stealth/ox-alpha

# Production (no laptop required — set on Railway/Vercel/Render):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Local STT — Superwhisper-style stack without heavy compute
# Presets: fast (tiny.en ~75MB) | balanced (small.en ~150MB, recommended) | accurate (base.en)
STT_PRESET=balanced
WHISPER_MODEL=Xenova/whisper-small.en
# Heavy option Superwhisper uses: CohereLabs/cohere-transcribe-03-2026 (~1.3 GB, needs GPU)

# STT: local whisper-tiny (fast) or Groq cloud when GROQ_API_KEY is set
STT_PRESET=fast
STT_PROVIDER=auto
# GROQ_API_KEY=gsk_...

# S1-mini normalizer (optional, adds ~1s latency) — ollama create s1-mini -f backend/models/s1-mini.Modelfile
S1_MINI_ENABLED=false

# Hackathon demo — set true to run live Bright Data scrape on onboarding exit
HACKATHON_DEMO_MODE=false

# Frontend mirrors (NEXT_PUBLIC_* in frontend/.env.local)
# NEXT_PUBLIC_HACKATHON_DEMO_MODE=false
# NEXT_PUBLIC_SKIP_SCRAPE_ANIMATION=false

BRIGHT_DATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
SCRAPER_PYTHON=../scraper/.venv/bin/python

WEBCMD_BRIDGE_SECRET=clearweb-dev-bridge
WEBCMD_ENABLED=true
FRONTEND_URL=http://localhost:3000

# TTS: Groq Orpheus when GROQ_API_KEY is set (same key as STT)
TTS_PROVIDER=auto
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
# Fallback Edge voice if Groq TTS is unavailable
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+4%
TTS_PITCH=+0Hz
