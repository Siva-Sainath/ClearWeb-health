# Server Configuration
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-app.vercel.app

# WebCmd Bridge Security
WEBCMD_BRIDGE_SECRET=your_shared_webcmd_bridge_secret
WEBCMD_ENABLED=true

# LLM Provider Configuration
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=stealth/ox-alpha
OPENROUTER_REFERER=https://your-app.vercel.app
OPENROUTER_APP_TITLE=Clearweb Health

# Voice & Speech (TTS / STT)
TTS_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
STT_PROVIDER=auto
STT_PRESET=fast
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Bright Data (Web Unlocker for scraping / query)
BRIGHT_DATA_API_TOKEN=your_bright_data_api_token
BRIGHTDATA_UNLOCKER_ZONE=your_brightdata_unlocker_zone

# Local Development / Ollama Fallback (Optional)
OLLAMA_BASE=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
