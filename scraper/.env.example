# Copy to scraper/.env — same API key as backend BRIGHT_DATA_API_TOKEN
BRIGHTDATA_API_KEY=ae7bd01e-a798-485b-beba-f4fff08b6db3

# Web Unlocker zone for all MRF file downloads + portal fallback fetches
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1

# Route all downloads through Web Unlocker (required for hackathon — do not disable)
BRIGHTDATA_USE_UNLOCKER_ALL=1

# Live demo: sync collector timeout seconds (Ascension portals can take ~90s)
BRIGHTDATA_SYNC_TIMEOUT=120

# Watcher: hours between full watchdog passes (default 6)
WATCHER_INTERVAL_HOURS=6

# Watcher uses async collectors (batch pre-warm); live run_job uses sync
WATCHER_ASYNC=1

# Optional: limit watcher to specific hospital ids (comma-separated, empty = all)
# WATCHER_HOSPITAL_IDS=st_davids_medical_center_austin,dell_seton_medical_center
